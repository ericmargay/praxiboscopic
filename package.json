{
  "name": "praxiboscopic",
  "private": true,
  "version": "0.1.0",
  "description": "Praxiboscopic · simulador de cine mecánico (película en loop, estroboscopio y linterna) con estudio de animación, generador de fotogramas y fabricación de película transparente. Obra construida con @aminoacid/omega.",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "captura": "node scripts/captura.mjs",
    "publicar": "bash scripts/publicar.sh"
  },
  "dependencies": {
    "@aminoacid/omega": "file:../omega",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
